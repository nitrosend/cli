{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nitrosend.com/cli/stream-event-v1.json",
  "type": "object",
  "required": ["schema_version", "type", "command", "data"],
  "properties": {
    "schema_version": { "const": 1 },
    "type": {
      "enum": ["started", "progress", "tool_call", "approval_required", "completed", "error"]
    },
    "command": { "type": "string" },
    "data": {},
    "meta": { "type": "object" }
  }
}
