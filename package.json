{
  "name": "@nitrosend/cli",
  "version": "0.2.7",
  "description": "Send email and SMS, run flows and campaigns, and call Nitrosend MCP tools from the terminal.",
  "keywords": [
    "nitrosend",
    "cli",
    "email",
    "email-marketing",
    "sms",
    "marketing-automation",
    "transactional-email",
    "campaigns",
    "automation",
    "contacts",
    "mcp",
    "model-context-protocol",
    "ai-agent",
    "agentic",
    "claude"
  ],
  "homepage": "https://nitrosend.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/nitrosend/cli.git"
  },
  "bugs": {
    "url": "https://github.com/nitrosend/cli/issues"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "nitrosend": "dist/index.js"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "schemas",
    "docs",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && node scripts/chmod-bin.mjs",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node scripts/run-tests.mjs",
    "lint": "npm run typecheck",
    "secret-scan": "node scripts/secret-scan.mjs",
    "test:stdio-contract": "npm run build && node scripts/stdio-contract.mjs",
    "test:dashboard-contract": "npm run build && node scripts/dashboard-contract.mjs",
    "test:machine-contract": "npm run build && node scripts/machine-contract.mjs",
    "test:perf-budget": "npm run build && node scripts/perf-budget.mjs",
    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "typescript": "^6.0.3"
  }
}
